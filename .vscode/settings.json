{
  // Use the project virtualenv. Create it with `make install` (or
  // `python -m venv .venv && pip install -e ".[dev]"`), then reload the window.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  // Resolve the src/ layout so `import scouter` works even before an install.
  "python.analysis.extraPaths": ["src"],
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.autoImportCompletions": true,

  // The vendored submodules are not ours to analyze - keep Pylance out of them.
  "python.analysis.exclude": ["third_party/**", ".venv/**", "**/*.egg-info/**"],
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.egg-info": true
  },
  "files.watcherExclude": {
    "**/third_party/**": true,
    "**/.venv/**": true
  },

  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"]
}
