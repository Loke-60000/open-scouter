{
  "venvPath": ".",
  "venv": ".venv",
  "extraPaths": ["src"],
  "include": ["src", "tests", "scripts"],
  "exclude": [
    "third_party",
    ".venv",
    "**/__pycache__",
    "**/*.egg-info",
    "build",
    "dist"
  ],
  "typeCheckingMode": "basic",
  "reportMissingModuleSource": "none",
  "reportUnusedFunction": "none"
}
