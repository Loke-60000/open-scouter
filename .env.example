# Copy to .env and edit. All keys are SCOUTER_<FIELD> (see src/scouter/config.py).

# ---- backend --------------------------------------------------------------
SCOUTER_BACKEND=vllm

# Model to serve: HF repo id or local path.
SCOUTER_MODEL=Qwen/Qwen3-0.6B
SCOUTER_SERVED_MODEL_NAME=scouter

# ---- assistant axis -------------------------------------------------------
# Local .pt/.npy/.npz path, or "hf:<model-key>" (e.g. hf:qwen-3-32b) to pull
# from the precomputed dataset. Empty = no axis (monitoring/steering disabled).
# Shipped precomputed vectors for the default Qwen3-0.6B work out of the box:
SCOUTER_AXIS=precomputed/qwen3-0.6b/axis.npz
SCOUTER_AXIS_HF_REPO=lu-christina/assistant-axis-vectors
# Residual-stream layer for monitoring/steering. -1 => num_layers // 2.
SCOUTER_TARGET_LAYER=-1

# Emotion vectors to monitor (a .npz from `scouter-emotions`). Empty = none.
# Not shipped precomputed: build on a capable model, fine-grained emotions do
# not separate on a 0.6B. Monitoring needs no steering.
SCOUTER_EMOTIONS=

# ---- steering defaults ----------------------------------------------------
# off | addition | capping  (capping is vLLM-only)
SCOUTER_STEER_MODE=off
SCOUTER_STEER_COEFFICIENT=0.0
SCOUTER_STEER_CAP_THRESHOLD=0.0

# ---- monitoring -----------------------------------------------------------
SCOUTER_MONITOR_ENABLED=true

# ---- vLLM -----------------------------------------------------------------
SCOUTER_TENSOR_PARALLEL_SIZE=1
SCOUTER_GPU_MEMORY_UTILIZATION=0.90
# steer_hook_act (steering) or probe_hidden_states (layer-resolved monitoring)
SCOUTER_VLLM_HOOK_WORKER=steer_hook_act

# ---- server ---------------------------------------------------------------
SCOUTER_HOST=0.0.0.0
SCOUTER_PORT=8000
SCOUTER_CACHE_DIR=/data/axes
